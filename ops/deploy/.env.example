# mynd Core deployment environment (example — never commit real secrets).
# Onyx's own env vars (POSTGRES_*, REDIS_*, AUTH_TYPE, SSO config, model server,
# Vespa, etc.) still apply; see core/deployment for the upstream reference.

# --- mynd layer ---
MYND_CONFIG_DIR=/app/config

# Deployment topology:
#   unset            -> shared multi-product deployment (ai.myndlabs.tech/<slug>)
#   MYND_PRODUCT=eng -> standalone single-product deployment (this app IS eng)
# When set, set NEXT_PUBLIC_MYND_PRODUCT to the same slug for the web build and
# add a `/ -> /<slug>` rewrite (see ops/deploy/README.md).
# MYND_PRODUCT=eng
# NEXT_PUBLIC_MYND_PRODUCT=eng

# Per-product retrieval isolation (plan §8.1). OFF by default — requires
# documents to be tagged with their product at index time before enabling.
MYND_RETRIEVAL_ISOLATION=false

# Credential encryption. Provider: local | gcp | aws
MYND_KMS_PROVIDER=gcp
# gcp:
MYND_GCP_KMS_KEY=projects/PROJECT/locations/REGION/keyRings/mynd/cryptoKeys/llm-creds
# aws:
# MYND_AWS_KMS_KEY_ID=arn:aws:kms:REGION:ACCOUNT:key/KEY-ID
# local (dev only): a urlsafe base64 32-byte Fernet key
# MYND_LOCAL_ENCRYPTION_KEY=

# OAuth callback base (matches the provider client redirect URIs)
MYND_OAUTH_CALLBACK_BASE=https://ai.myndlabs.tech/oauth/callback

# Per-provider OAuth client config (only for providers you enable). Example:
# MYND_OAUTH_VERTEX_AI_CLIENT_ID=
# MYND_OAUTH_VERTEX_AI_CLIENT_SECRET=
# MYND_OAUTH_VERTEX_AI_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth
# MYND_OAUTH_VERTEX_AI_TOKEN_URL=https://oauth2.googleapis.com/token
# MYND_OAUTH_VERTEX_AI_SCOPES=https://www.googleapis.com/auth/cloud-platform
